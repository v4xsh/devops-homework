{
  "uid": "taskboard-final-app",
  "title": "TaskBoard API (final-app) - Vansh Dobhal 10099",
  "tags": ["taskboard", "final-project", "fastapi"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Backend targets up", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(up{namespace=\"final-app\", service=\"taskboard-backend\"})"}]},
    {"id": 2, "type": "stat", "title": "Requests / s", "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}},
     "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{namespace=\"final-app\", service=\"taskboard-backend\"}[1m]))"}]},
    {"id": 3, "type": "stat", "title": "5xx ratio", "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2}},
     "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{namespace=\"final-app\", service=\"taskboard-backend\", status=\"5xx\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"final-app\", service=\"taskboard-backend\"}[5m])), 0.001)"}]},
    {"id": 4, "type": "stat", "title": "Tasks created (total)", "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(taskboard_tasks_created_total{namespace=\"final-app\"})"}]},
    {"id": 5, "type": "stat", "title": "Backend replicas (HPA)", "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"final-app\"})"}]},
    {"id": 6, "type": "timeseries", "title": "Request rate by handler", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "reqps"}},
     "targets": [{"refId": "A", "expr": "sum by (handler, method, status) (rate(http_requests_total{namespace=\"final-app\", service=\"taskboard-backend\"}[1m]))", "legendFormat": "{{method}} {{handler}} {{status}}"}]},
    {"id": 7, "type": "timeseries", "title": "Latency p50 / p95 / p99", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [
       {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"final-app\", service=\"taskboard-backend\"}[2m])))", "legendFormat": "p50"},
       {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"final-app\", service=\"taskboard-backend\"}[2m])))", "legendFormat": "p95"},
       {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"final-app\", service=\"taskboard-backend\"}[2m])))", "legendFormat": "p99"}]},
    {"id": 8, "type": "timeseries", "title": "CPU (cores) per pod", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"final-app\", container!=\"\"}[1m]))", "legendFormat": "{{pod}}"}]},
    {"id": 9, "type": "timeseries", "title": "Memory working set per pod", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "bytes"}},
     "targets": [{"refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"final-app\", container!=\"\"})", "legendFormat": "{{pod}}"}]}
  ]
}
